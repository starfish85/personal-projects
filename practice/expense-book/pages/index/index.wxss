.page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.hero {
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 650;
}

.sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7a7268;
}

.card {
  background: #fffcf7;
  border: 1rpx solid #e6dfd4;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #7a7268;
  margin-bottom: 12rpx;
}

.field {
  height: 80rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border: 1rpx solid #e6dfd4;
  border-radius: 20rpx;
  font-size: 32rpx;
}

.submit {
  background: #c45c26;
  color: #fff;
  font-size: 32rpx;
  border-radius: 20rpx;
}

.submit::after {
  border: 0;
}

.hint {
  min-height: 36rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #7a7268;
}

.hint.error {
  color: #b42318;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
}

.stat {
  width: calc(50% - 8rpx);
  background: #fff;
  border: 1rpx solid #e6dfd4;
  border-radius: 24rpx;
  padding: 24rpx;
}

.stat.wide {
  width: 100%;
}

.name {
  font-size: 26rpx;
  color: #7a7268;
}

.num {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 650;
}

.num.衣 { color: #c45c7a; }
.num.食 { color: #d4782a; }
.num.住 { color: #3d8b7a; }
.num.行 { color: #3a6ea5; }
.num.其他 { color: #8a8378; }

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e6dfd4;
  font-size: 28rpx;
}

.row:last-child {
  border-bottom: 0;
}

.row-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #eeeae3;
}

.tag.衣 { background: #f8e4ea; color: #c45c7a; }
.tag.食 { background: #fbe9d8; color: #d4782a; }
.tag.住 { background: #dceee9; color: #3d8b7a; }
.tag.行 { background: #dce6f2; color: #3a6ea5; }

.meta {
  color: #7a7268;
}

.empty {
  color: #7a7268;
  font-size: 26rpx;
}
